// SEFT Abacus — Prisma schema (single source of truth for the database).
//
// Design rules baked into this schema:
//  - MULTI-INSTITUTE from day one: every domain record carries `instituteId`.
//    In Phase 1 only one institute (SEFT) is active, but the structure supports
//    many.
//  - SERVER IS THE SOURCE OF TRUTH: timing/scoring/level-up data lives here and
//    is written only by trusted server code. The practice-attempt tables that
//    record scores live with the practice engine (added in a later task); this
//    file currently defines the structural foundation (institutes, users,
//    groups, levels) plus level tracking.
//
// Prisma 7 notes: the new `prisma-client` generator emits the client into
// `lib/generated/prisma`. The datasource URL is supplied by `prisma.config.ts`
// (from DATABASE_URL), so there is no inline `url` here.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// A user's role.
/// STUDENT / TEACHER / ADMIN are scoped to one institute. SUPER_ADMIN is a
/// platform-level operator (Phase 2) who manages every institute; their own
/// `instituteId` points at a home institute but their access is cross-tenant.
enum Role {
  STUDENT
  TEACHER
  ADMIN
  SUPER_ADMIN
}

/// The arithmetic operation a practice level drills.
/// Phase 1 focuses on ADDITION / SUBTRACTION; the rest are reserved so we do
/// not need an enum migration to enable them later.
enum OperationType {
  ADDITION
  SUBTRACTION
  MULTIPLICATION
  DIVISION
  MIXED
}

/// Lifecycle of a timed practice attempt.
/// IN_PROGRESS → COMPLETED (submitted in time) or EXPIRED (ran out of time).
enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

/// How a practice session is scored. STANDARD is timed and can level up;
/// REVIEW is untimed drill-only (no expiry, no level-up);
/// CHALLENGE is a harder timed drill (shorter time, higher pass bar, no level-up);
/// EXAM is a teacher-scheduled timed attempt during an exam window (can level up).
enum PracticeMode {
  STANDARD
  REVIEW
  CHALLENGE
  EXAM
}

/// Optional difficulty tag on institute question-bank entries.
enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

/// Draft questions are admin-only until published into live sessions.
enum QuestionStatus {
  DRAFT
  PUBLISHED
}

/// Question-control and curriculum actions recorded for compliance audit.
enum AuditAction {
  QUESTION_CREATED
  QUESTION_UPDATED
  QUESTION_DELETED
  QUESTION_PUBLISHED
  QUESTION_UNPUBLISHED
  QUESTION_ENABLED
  QUESTION_DISABLED
  QUESTIONS_IMPORTED
  QUESTIONS_REORDERED
  GROUP_QUESTION_ENABLED
  GROUP_QUESTION_DISABLED
  CURRICULUM_VERSION_BUMPED
  LEVEL_BANK_ONLY_ENABLED
  LEVEL_BANK_ONLY_DISABLED
  PERMISSION_GRANTED
  PERMISSION_REVOKED
  CLASS_PERFORMANCE_RECORDED
  CLASS_PERFORMANCE_UPDATED
  ACADEMIC_LEVEL_CREATED
  ACADEMIC_LEVEL_UPDATED
  STUDENT_ACADEMIC_LEVEL_CHANGED
  HOMEWORK_SCHEDULE_CREATED
  HOMEWORK_SCHEDULE_UPDATED
  HOMEWORK_SUBMISSION_REVIEWED
}

/// Attendance state recorded with a teacher-entered class performance mark.
enum ClassPerformanceStatus {
  PRESENT
  ABSENT
}

/// Explicit per-user permission override. Missing row means role default.
enum PermissionEffect {
  ALLOW
  DENY
}

enum HomeworkScheduleMode {
  WEEKLY_RECURRING
  MANUAL_SPECIFIC
}

enum HomeworkTargetType {
  GROUP
  STUDENT
}

enum HomeworkScheduleStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum HomeworkSubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMISSION_REQUESTED
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

/// An institute is the top-level tenant. SEFT is the only active one in Phase 1.
model Institute {
  id           String  @id @default(cuid())
  /// URL-safe identifier, e.g. "seft". Unique across the platform.
  slug         String  @unique
  name         String
  /// Optional white-label branding (Phase 2.3). Shown in the authenticated UI
  /// for this tenant. Null falls back to the platform defaults.
  /// Short marketing line under the institute name.
  tagline      String?
  /// Absolute URL to the institute's logo image.
  logoUrl      String?
  /// Optional brand accent as `#RRGGBB`. Drives `--primary` in the authenticated UI.
  primaryColor String?
  /// Lets an institute be disabled without deleting its data.
  isActive     Boolean @default(true)

  /// Active question-bank generation used for new practice and exams.
  activeCurriculumVersionId String?
  activeCurriculumVersion   CurriculumVersion? @relation("ActiveCurriculumVersion", fields: [activeCurriculumVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  groups                  Group[]
  levels                  Level[]
  practiceSessions        PracticeSession[]
  scheduledExams          ScheduledExam[]
  levelQuestions          LevelQuestion[]
  curriculumVersions      CurriculumVersion[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]
  classPerformances       ClassPerformance[]
  classPerformanceEntries ClassPerformanceEntry[]
  academicLevels          AcademicLevel[]
  homeworkSchedules       HomeworkSchedule[]
  homeworkOccurrences     HomeworkOccurrence[]
  homeworkExpectations    HomeworkExpectation[]

  @@map("institute")
}

/// A numbered snapshot of an institute's published question bank.
model CurriculumVersion {
  id String @id @default(cuid())

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  /// Monotonic per institute (1, 2, 3 …).
  versionNumber Int

  /// Optional admin note, e.g. "Term 2 refresh".
  label String?

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  institutesActiveFor Institute[]       @relation("ActiveCurriculumVersion")
  levelQuestions      LevelQuestion[]
  practiceSessions    PracticeSession[]
  scheduledExams      ScheduledExam[]

  @@unique([instituteId, versionNumber])
  @@index([instituteId])
  @@map("curriculum_version")
}

// ---------------------------------------------------------------------------
// Auth + identity
//
// The four models below (User, Session, Account, Verification) are the shape
// better-auth's Prisma adapter expects. `User` is extended with our own fields
// (role, instituteId, group/level relations). The auth wiring itself is set up
// in a later task; here we only define the tables.
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // --- SEFT Abacus custom fields ---

  /// Drives route protection and data scoping. Carried in the session.
  role Role @default(STUDENT)

  /// Soft-disable flag. A disabled user keeps ALL their data/history but cannot
  /// sign in or use the app (enforced server-side in requireUser, which also
  /// revokes their sessions). Reversible. Mirrors Institute.isActive.
  isActive Boolean @default(true)

  /// Every user belongs to exactly one institute. Carried in the session.
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  /// Groups this user owns as a TEACHER (empty for students/admins).
  taughtGroups Group[] @relation("GroupTeacher")

  /// The group a STUDENT belongs to (null for teachers/admins, and for
  /// students not yet placed in a group).
  groupId String?
  group   Group?  @relation("GroupStudents", fields: [groupId], references: [id], onDelete: SetNull)

  /// A STUDENT's current level, used for level-up progression. Null until a
  /// teacher assigns a starting level.
  currentLevelId String?
  currentLevel   Level?  @relation("StudentCurrentLevel", fields: [currentLevelId], references: [id], onDelete: SetNull)

  /// Teacher-controlled offline/main academic level. This is independent from
  /// the automatic practice/exam progression stored in currentLevelId.
  academicLevelId String?
  academicLevel   AcademicLevel? @relation("StudentAcademicLevel", fields: [academicLevelId], references: [id], onDelete: SetNull)

  /// Timed practice attempts made by this STUDENT.
  practiceSessions PracticeSession[] @relation("StudentSessions")

  /// Scheduled exams created by this teacher or admin.
  scheduledExamsCreated ScheduledExam[] @relation("ScheduledExamCreator")

  /// Question-control audit events performed by this user.
  auditLogs AuditLog[] @relation("AuditLogActor")

  /// In-app notifications delivered to this user.
  notifications Notification[]

  /// Notifications where this user is credited as the actor (e.g. exam scheduler).
  notificationActions Notification[] @relation("NotificationActor")

  /// Per-type in-app delivery toggles (N7). Absent row = enabled.
  notificationPreferences NotificationPreference[]

  /// Browser push subscriptions for this user across devices.
  pushSubscriptions PushSubscription[]

  /// Explicit permission overrides targeting this user.
  permissionOverrides UserPermission[] @relation("UserPermissionTarget")

  /// Explicit permission overrides granted or revoked by this user.
  grantedPermissionOverrides UserPermission[] @relation("UserPermissionGranter")

  /// Class performance sheets created by this teacher.
  classPerformancesCreated ClassPerformance[] @relation("ClassPerformanceCreator")

  /// Teacher-entered class performance history for this student.
  classPerformanceEntries ClassPerformanceEntry[] @relation("ClassPerformanceStudent")

  homeworkSchedulesCreated  HomeworkSchedule[]    @relation("HomeworkScheduleCreator")
  homeworkSchedulesTargeted HomeworkSchedule[]    @relation("HomeworkScheduleStudentTarget")
  homeworkExpectations      HomeworkExpectation[] @relation("HomeworkExpectationStudent")
  homeworkReviews           HomeworkSubmission[]  @relation("HomeworkSubmissionReviewer")

  // --- better-auth relations ---
  sessions Session[]
  accounts Account[]

  @@index([instituteId])
  @@index([groupId])
  @@index([academicLevelId])
  @@map("user")
}

/// Per-user permission overrides for RBAC Phase 2.
model UserPermission {
  userId String
  user   User   @relation("UserPermissionTarget", fields: [userId], references: [id], onDelete: Cascade)

  /// Permission string from lib/permissions.ts. Stored as text so the catalog
  /// can evolve without requiring an enum migration for every app permission.
  permission String

  /// ALLOW adds beyond role defaults. DENY removes a default permission.
  effect PermissionEffect

  grantedById String
  grantedBy   User   @relation("UserPermissionGranter", fields: [grantedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, permission])
  @@index([grantedById])
  @@map("user_permission")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Hashed password for the email/password provider.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Teaching structures
// ---------------------------------------------------------------------------

/// A teacher's class. Students are placed into a group; a group belongs to one
/// teacher and one institute.
model Group {
  id   String @id @default(cuid())
  name String

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  /// The teacher who owns this group.
  teacherId String
  teacher   User   @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  /// Students placed in this group.
  students User[] @relation("GroupStudents")

  /// Optional per-level time limits for students in this group.
  levelRules GroupLevelRule[]

  scheduledExams ScheduledExam[]

  questionRules GroupQuestionRule[]

  classPerformances ClassPerformance[]

  homeworkSchedules HomeworkSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instituteId])
  @@index([teacherId])
  @@map("group")
}

/// Teacher-controlled main/offline level. It intentionally has no relation to
/// the existing practice Level model: the two progressions are independent.
model AcademicLevel {
  id String @id @default(cuid())

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  name       String
  orderIndex Int
  isActive   Boolean @default(true)

  students User[] @relation("StudentAcademicLevel")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instituteId, orderIndex])
  @@index([instituteId, isActive])
  @@map("academic_level")
}

/// Per-group timed-practice override for a curriculum level.
/// Students in the group use this limit instead of `Level.timeLimitSeconds`.
model GroupLevelRule {
  id String @id @default(cuid())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  levelId String
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)

  timeLimitSeconds Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, levelId])
  @@index([groupId])
  @@index([levelId])
  @@map("group_level_rule")
}

/// A practice level: the curriculum step a student drills. Levels are ordered
/// per institute (orderIndex) and a student progresses through them.
///
/// The fields below define what the SERVER uses to generate questions and to
/// score/decide a pass — the browser never sets these.
model Level {
  id   String @id @default(cuid())
  name String

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  /// Ordering within an institute (1, 2, 3 …). Drives level-up.
  orderIndex Int

  // --- Server-enforced scoring / timing (trusted) ---

  /// How many questions a practice session contains.
  questionCount    Int
  /// Total time the server allows for the whole session, in seconds.
  timeLimitSeconds Int
  /// Minimum accuracy (percentage, 0–100) required to pass and level up.
  passAccuracy     Int

  // --- Question generation parameters (Phase 1: arithmetic) ---

  /// Which operation this level drills.
  operation        OperationType
  /// How many numbers appear in one question (e.g. 3 → a + b + c).
  termsPerQuestion Int
  /// Inclusive lower bound for each generated number.
  minNumber        Int
  /// Inclusive upper bound for each generated number.
  maxNumber        Int

  /// When true, a student must pass the previous level (by orderIndex) before
  /// practising or being assigned here. Level 1 ignores this. Admins can turn
  /// off to allow skipping ahead.
  requiresPreviousPass Boolean @default(true)

  /// When true, sessions use only fixed bank questions — no dynamic fallback.
  /// Practice and exams are blocked if the effective bank pool is too small.
  bankOnly Boolean @default(false)

  /// Students currently sitting on this level.
  studentsOnLevel User[] @relation("StudentCurrentLevel")

  /// Practice attempts made at this level.
  practiceSessions PracticeSession[]

  groupLevelRules GroupLevelRule[]

  scheduledExams ScheduledExam[]

  levelQuestions LevelQuestion[]

  /// When set, the level is archived (soft-deleted). Hidden from assignment and
  /// new practice; existing session history is kept.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No two levels in the same institute share an order position.
  @@unique([instituteId, orderIndex])
  @@index([instituteId])
  @@map("level")
}

// ---------------------------------------------------------------------------
// Institute question bank
//
// LevelQuestion entries are owned by the institute Admin. Teachers can disable
// specific questions for their group via GroupQuestionRule. When the bank is
// empty or too small, the practice engine falls back to dynamic generation.
// ---------------------------------------------------------------------------

model LevelQuestion {
  id String @id @default(cuid())

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  levelId String
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)

  /// Display prompt, e.g. "12 + 7 + 3".
  prompt String

  /// Trusted answer — never sent to the client during an in-progress session.
  correctAnswer Int

  /// Optional curriculum tag, e.g. "Carry", "Speed drill".
  category String?

  difficulty QuestionDifficulty @default(MEDIUM)

  /// Draft rows are hidden from practice/exams until published.
  status QuestionStatus @default(DRAFT)

  /// Institute-wide active flag (Admin). Inactive questions are never picked.
  isActive Boolean @default(true)

  /// Sort hint for Admin lists; does not affect random session pick order.
  orderIndex Int @default(0)

  /// Set when published — only the institute's active version is picked live.
  curriculumVersionId String?
  curriculumVersion   CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupRules             GroupQuestionRule[]
  practiceQuestions      PracticeQuestion[]
  scheduledExamQuestions ScheduledExamQuestion[]

  @@index([instituteId])
  @@index([levelId])
  @@index([levelId, isActive])
  @@index([levelId, status])
  @@index([levelId, curriculumVersionId])
  @@map("level_question")
}

/// Per-group enable/disable override for a bank question (Teacher).
/// No row means enabled (when the parent LevelQuestion is active).
model GroupQuestionRule {
  id String @id @default(cuid())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  questionId String
  question   LevelQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, questionId])
  @@index([groupId])
  @@index([questionId])
  @@map("group_question_rule")
}

// ---------------------------------------------------------------------------
// Teacher-entered class performance
// ---------------------------------------------------------------------------

/// One date-wise class performance sheet for a group. This is deliberately
/// separate from automatic practice/exam scoring and never affects level-up.
model ClassPerformance {
  id String @id @default(cuid())

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  /// Calendar date of the class. PostgreSQL stores only the date portion.
  classDate DateTime @db.Date

  /// Maximum possible mark for this class, e.g. 10 or 100.
  maximumMark Decimal @db.Decimal(8, 2)

  createdById String
  createdBy   User   @relation("ClassPerformanceCreator", fields: [createdById], references: [id], onDelete: Restrict)

  entries ClassPerformanceEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, classDate])
  @@index([instituteId, classDate])
  @@index([groupId, classDate])
  @@map("class_performance")
}

/// One student's mark and attendance state on a class performance sheet.
model ClassPerformanceEntry {
  id String @id @default(cuid())

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  classPerformanceId String
  classPerformance   ClassPerformance @relation(fields: [classPerformanceId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("ClassPerformanceStudent", fields: [studentId], references: [id], onDelete: Cascade)

  /// Decimal marks are supported (e.g. 8.5 out of 10).
  mark   Decimal                @db.Decimal(8, 2)
  status ClassPerformanceStatus @default(PRESENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classPerformanceId, studentId])
  @@index([instituteId])
  @@index([studentId])
  @@map("class_performance_entry")
}

// ---------------------------------------------------------------------------
// Homework — teacher schedule, date-wise occurrence, roster snapshot, attempt
// ---------------------------------------------------------------------------

/// A reusable weekly rule or one specific homework deadline. A target is
/// exactly one group or one student (enforced by a database check constraint).
model HomeworkSchedule {
  id String @id @default(cuid())

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("HomeworkScheduleCreator", fields: [createdById], references: [id], onDelete: Restrict)

  mode       HomeworkScheduleMode
  targetType HomeworkTargetType

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  studentId String?
  student   User?   @relation("HomeworkScheduleStudentTarget", fields: [studentId], references: [id], onDelete: Cascade)

  title String

  /// Weekly schedules generate dates from startDate through optional endDate.
  startDate DateTime
  endDate   DateTime?

  /// Used only by MANUAL_SPECIFIC schedules.
  manualOpensAt DateTime?
  manualDueAt   DateTime?

  maxScore           Decimal                @db.Decimal(8, 2)
  timeLimitMinutes   Int
  showTimer          Boolean                @default(true)
  allowSamePageAgain Boolean                @default(false)
  status             HomeworkScheduleStatus @default(ACTIVE)

  slots       HomeworkScheduleSlot[]
  occurrences HomeworkOccurrence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instituteId, status])
  @@index([groupId])
  @@index([studentId])
  @@index([createdById])
  @@map("homework_schedule")
}

/// One weekday/time pair for a WEEKLY_RECURRING schedule. dayOfWeek uses
/// JavaScript numbering (0=Sunday ... 6=Saturday); minutes are Bangladesh-local.
model HomeworkScheduleSlot {
  id String @id @default(cuid())

  scheduleId String
  schedule   HomeworkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  dayOfWeek  Int
  openMinute Int
  dueMinute  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, dayOfWeek])
  @@index([scheduleId])
  @@map("homework_schedule_slot")
}

/// A concrete, date-wise homework window generated from a schedule. Score and
/// timer settings are snapshots so later schedule edits never rewrite history.
model HomeworkOccurrence {
  id String @id @default(cuid())

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  scheduleId String
  schedule   HomeworkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  opensAt DateTime
  dueAt   DateTime

  maxScoreSnapshot           Decimal @db.Decimal(8, 2)
  timeLimitMinutesSnapshot   Int
  showTimerSnapshot          Boolean
  allowSamePageAgainSnapshot Boolean

  /// Filled once when the occurrence opens. This freezes the eligible roster.
  expectationsMaterializedAt DateTime?
  cancelledAt                DateTime?

  expectations HomeworkExpectation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, opensAt])
  @@index([instituteId, opensAt])
  @@index([scheduleId, dueAt])
  @@map("homework_occurrence")
}

/// Immutable eligibility snapshot: who owed one occurrence and which Academic
/// Level the teacher had assigned when that occurrence opened.
model HomeworkExpectation {
  id String @id @default(cuid())

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  occurrenceId String
  occurrence   HomeworkOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("HomeworkExpectationStudent", fields: [studentId], references: [id], onDelete: Cascade)

  academicLevelIdSnapshot   String?
  academicLevelNameSnapshot String?

  submissions HomeworkSubmission[]

  createdAt DateTime @default(now())

  @@unique([occurrenceId, studentId])
  @@index([instituteId, studentId])
  @@index([studentId, createdAt])
  @@map("homework_expectation")
}

/// One upload attempt. Resubmission appends another attempt; reviewed history
/// is never overwritten. Photo keys are private object references, not URLs.
model HomeworkSubmission {
  id String @id @default(cuid())

  expectationId String
  expectation   HomeworkExpectation @relation(fields: [expectationId], references: [id], onDelete: Cascade)

  attemptNumber Int
  pageNumber    String

  firstPhotoKey String
  finalPhotoKey String?

  startedAt         DateTime  @default(now())
  submittedAt       DateTime?
  completionSeconds Int?
  isLate            Boolean?
  lateBySeconds     Int?
  isOverTimeLimit   Boolean?
  overtimeSeconds   Int?

  status HomeworkSubmissionStatus @default(IN_PROGRESS)

  score          Decimal?  @db.Decimal(8, 2)
  teacherComment String?
  reviewedById   String?
  reviewedBy     User?     @relation("HomeworkSubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([expectationId, attemptNumber])
  @@index([expectationId, status])
  @@index([reviewedById])
  @@map("homework_submission")
}

// ---------------------------------------------------------------------------
// Scheduled exams
//
// A teacher schedules a timed exam window for a group at a specific level.
// Students in that group may start one attempt while the window is open.
// ---------------------------------------------------------------------------

model ScheduledExam {
  id String @id @default(cuid())

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  levelId String
  level   Level  @relation(fields: [levelId], references: [id])

  /// Optional label shown on the student dashboard (e.g. "Weekly test").
  title String?

  /// Inclusive window when students may start the exam (server clock).
  opensAt  DateTime
  closesAt DateTime

  createdById String
  createdBy   User   @relation("ScheduledExamCreator", fields: [createdById], references: [id], onDelete: Cascade)

  /// Question bank generation frozen when the fixed paper was built.
  curriculumVersionId String?
  curriculumVersion   CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  practiceSessions PracticeSession[]
  paperQuestions   ScheduledExamQuestion[]

  @@index([instituteId])
  @@index([groupId])
  @@index([opensAt, closesAt])
  @@map("scheduled_exam")
}

/// Fixed question paper for a scheduled exam — identical for every student in the group.
model ScheduledExamQuestion {
  id String @id @default(cuid())

  scheduledExamId String
  scheduledExam   ScheduledExam @relation(fields: [scheduledExamId], references: [id], onDelete: Cascade)

  /// Position within the paper (0-based).
  index Int

  prompt        String
  correctAnswer Int

  /// When picked from the institute bank, links back for analytics/audit.
  sourceQuestionId String?
  sourceQuestion   LevelQuestion? @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)

  @@unique([scheduledExamId, index])
  @@index([scheduledExamId])
  @@map("scheduled_exam_question")
}

// ---------------------------------------------------------------------------
// Practice attempts
//
// A PracticeSession is one timed attempt by a student at a level. EVERYTHING
// that matters for fairness lives here and is written only by trusted server
// code: the server generates the questions (storing the correct answers, which
// are never sent to the browser until grading), stamps startedAt/expiresAt, and
// computes correctness, accuracy, pass, and level-up on submit.
// ---------------------------------------------------------------------------

model PracticeSession {
  id String @id @default(cuid())

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  studentId String
  student   User   @relation("StudentSessions", fields: [studentId], references: [id], onDelete: Cascade)

  levelId String
  level   Level  @relation(fields: [levelId], references: [id])

  status SessionStatus @default(IN_PROGRESS)

  /// STANDARD = timed attempt that can level up; REVIEW = untimed drill;
  /// CHALLENGE = harder timed drill without level-up;
  /// EXAM = scheduled timed attempt linked to a ScheduledExam.
  mode PracticeMode @default(STANDARD)

  /// Set when `mode` is EXAM — links this attempt to the scheduled exam slot.
  scheduledExamId String?
  scheduledExam   ScheduledExam? @relation(fields: [scheduledExamId], references: [id], onDelete: SetNull)

  /// Active curriculum generation when the session started (audit).
  curriculumVersionId String?
  curriculumVersion   CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id], onDelete: SetNull)

  /// Server clock. The session must be submitted on or before `expiresAt`.
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  submittedAt DateTime?

  // --- Server-computed results (trusted) ---
  totalQuestions Int
  correctCount   Int     @default(0)
  /// Accuracy as a percentage, 0–100.
  accuracy       Int     @default(0)
  /// Did the attempt meet the level's pass threshold (in time)?
  passed         Boolean @default(false)
  /// Did passing this attempt advance the student to the next level?
  leveledUp      Boolean @default(false)

  /// Server-detected anomaly flags (informational; no auto-penalty yet).
  anomalyFlags String[] @default([])

  createdAt DateTime @default(now())

  questions PracticeQuestion[]

  @@unique([studentId, scheduledExamId])
  @@index([studentId])
  @@index([instituteId])
  @@index([levelId])
  @@index([scheduledExamId])
  @@map("practice_session")
}

model PracticeQuestion {
  id String @id @default(cuid())

  sessionId String
  session   PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Position within the session (0-based).
  index Int

  /// Human-readable prompt shown to the student, e.g. "12 + 7 + 3".
  prompt String

  /// The correct answer — server-only. Never serialised to the client while a
  /// session is in progress.
  correctAnswer Int

  /// What the student submitted (null if left blank / not reached).
  studentAnswer Int?
  /// Graded server-side on submit.
  isCorrect     Boolean?

  /// When picked from the institute bank, links back for analytics/audit.
  sourceQuestionId String?
  sourceQuestion   LevelQuestion? @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)

  @@unique([sessionId, index])
  @@index([sessionId])
  @@index([sourceQuestionId])
  @@map("practice_question")
}

// ---------------------------------------------------------------------------
// Compliance audit trail (question control)
// ---------------------------------------------------------------------------

/// Immutable-style activity log for institute question-control changes.
model AuditLog {
  id String @id @default(cuid())

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  actorUserId String
  actor       User   @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  actorRole   Role

  action AuditAction

  /// Entity type for filtering, e.g. LevelQuestion, Group, Level.
  targetType String
  targetId   String?

  /// Pre-rendered one-line summary for list UI.
  summary String

  /// Optional structured details (counts, names, flags).
  metadata Json?

  createdAt DateTime @default(now())

  @@index([instituteId, createdAt(sort: Desc)])
  @@index([instituteId, action])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// In-app notifications (N1)
// ---------------------------------------------------------------------------

enum NotificationType {
  EXAM_SCHEDULED
  EXAM_CANCELLED
  EXAM_OPEN
  EXAM_CLOSING_SOON
  EXAM_CLOSED_SUMMARY
  LEVEL_UP
  LEVEL_ASSIGNED
  STUDENT_JOINED_GROUP
  GROUP_BANK_BLOCKED
  GROUP_QUESTION_DISABLED
  BANK_ONLY_BLOCKED
  BANK_PARTIAL_WARNING
  CURRICULUM_BUMPED
  INSTITUTE_CREATED
  INSTITUTE_DISABLED
  INSTITUTE_ENABLED
  PERMISSION_CHANGED
}

/// Per-user in-app notification. Email/push are out of scope for N1.
model Notification {
  id String @id @default(cuid())

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  title String
  body  String
  href  String

  /// Idempotency key — e.g. `EXAM_OPEN:{examId}`. Unique per user when set.
  dedupeKey String?

  /// Structured context for deep links and future email templates (N5).
  metadata Json?

  /// User credited as the actor — e.g. teacher who scheduled an exam (N5).
  actorUserId String?
  actor       User?   @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([actorUserId])
  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notification")
}

/// Per-user opt-out for a notification type (N7). No row means delivery enabled.
model NotificationPreference {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  type NotificationType

  /// When false, new notifications of this type are suppressed.
  enabled Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@id([userId, type])
  @@index([instituteId])
  @@map("notification_preference")
}

/// Per-browser Web Push endpoint. Muting notification preferences suppresses
/// both in-app rows and push delivery because push is triggered from the same
/// trusted notification write path.
model PushSubscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  userAgent String?

  disabledAt   DateTime?
  lastFailedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([instituteId])
  @@map("push_subscription")
}
